{
 "verify_identity": {
  "type": "function",
  "function": {
   "name": "verify_identity",
   "handler": "__function__:api_call",
   "description": "Check one security answer. Three wrong answers in total end the check.",
   "parameters": {
    "type": "object",
    "properties": {
     "url": {
      "type": "string",
      "default": "https://freya-bank-mock.freyavoice.workers.dev/v1/verify_identity"
     },
     "method": {
      "type": "string",
      "default": "POST"
     },
     "headers": {
      "type": "object",
      "properties": {
       "Content-Type": {
        "type": "string",
        "default": "application/json"
       }
      }
     },
     "body": {
      "type": "object",
      "required": [
       "field",
       "answer"
      ],
      "properties": {
       "customer_id": {
        "type": "string",
        "default": "{{customer_id}}"
       },
       "field": {
        "type": "string",
        "enum": [
         "date_of_birth",
         "phone_last4"
        ],
        "default": "{{field}}"
       },
       "answer": {
        "type": "string",
        "default": "{{answer}}",
        "description": "For date_of_birth: the date as YYYY-MM-DD. Callers say dates in words, the agent converts. An unreadable value is rejected with ok=false and is not counted as a wrong answer. For phone_last4: four digits."
       }
      }
     }
    }
   }
  },
  "config": {
   "timeoutMs": 12000,
   "maxRetries": 0
  }
 },
