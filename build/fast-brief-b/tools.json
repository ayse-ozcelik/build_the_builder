 "close_call": {
  "type": "function",
  "function": {
   "name": "close_call",
   "handler": "__function__:api_call",
   "description": "End the call. Always the last tool call. Nothing is accepted after it.",
   "parameters": {
    "type": "object",
    "properties": {
     "url": {
      "type": "string",
      "default": "https://freya-bank-mock.freyavoice.workers.dev/v1/close_call"
     },
     "method": {
      "type": "string",
      "default": "POST"
     },
     "headers": {
      "type": "object",
      "properties": {
       "Content-Type": {
        "type": "string",
        "default": "application/json"
       }
      }
     },
     "body": {
      "type": "object",
      "required": [
       "outcome"
      ],
      "properties": {
       "customer_id": {
        "type": "string",
        "default": "{{customer_id}}"
       },
       "outcome": {
        "type": "string",
        "enum": [
         "promise",
         "paid",
         "transferred",
         "no_promise",
         "not_verified",
         "not_reached"
        ],
        "default": "{{outcome}}"
       },
       "reason": {
        "type": "string",
        "default": "{{reason}}",
        "description": "Required for every outcome except promise and paid. See the table in the brief."
       }
      }
     }
    }
   }
  },
  "config": {
   "timeoutMs": 12000,
   "maxRetries": 0
  }
 }
