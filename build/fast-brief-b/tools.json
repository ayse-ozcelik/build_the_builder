 "create_promise": {
  "type": "function",
  "function": {
   "name": "create_promise",
   "handler": "__function__:api_call",
   "description": "Record a payment promise. One per product.",
   "parameters": {
    "type": "object",
    "properties": {
     "url": {
      "type": "string",
      "default": "https://freya-bank-mock.freyavoice.workers.dev/v1/create_promise"
     },
     "method": {
      "type": "string",
      "default": "POST"
     },
     "headers": {
      "type": "object",
      "properties": {
       "Content-Type": {
        "type": "string",
        "default": "application/json"
       }
      }
     },
     "body": {
      "type": "object",
      "required": [
       "product_id",
       "amount",
       "date"
      ],
      "properties": {
       "customer_id": {
        "type": "string",
        "default": "{{customer_id}}"
       },
       "product_id": {
        "type": "string",
        "default": "{{product_id}}"
       },
       "amount": {
        "type": "number",
        "default": "{{amount}}"
       },
       "date": {
        "type": "string",
        "default": "{{date}}",
        "description": "(YYYY-MM-DD)"
       }
      }
     }
    }
   }
  },
  "config": {
   "timeoutMs": 12000,
   "maxRetries": 0
  }
 },
 "add_note": {
  "type": "function",
  "function": {
   "name": "add_note",
   "handler": "__function__:api_call",
   "description": "Brief B: record why a product ended without a promise.",
