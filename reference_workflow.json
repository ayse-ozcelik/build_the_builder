      "node_type": "conversation",
      "role_message": "",
      "task_message": "You are the digital assistant of Freya Bank. Your only job here is to verify the customer's identity. Speak English, one or two short sentences per turn.\nOnce the customer confirms who they are, ask for their date of birth, then the last four digits of their phone number, and call verify_identity for each answer.\nYou do not know why the bank is calling. If asked, say you can explain after the security check.\nIf the identity check fails, say goodbye, ending with \"Have a good day.\"",
      "on_enter": {
        "type": "tts",
        "text": "Hello, this is the digital assistant of Freya Bank. Am I speaking with {{title}} {{last_name}}?"
      },
      "on_enter_first_entry_only": false,
      "passthrough": false,
      "interruptible": false,
      "return_to_previous_on_interrupt": false,
      "disable_inactivity_monitor": false,
      "max_node_turns": 80,
      "max_turn_transition": null,
      "truncation_strategy": "keep_all",
      "truncation_window_size": 10,
      "passthrough_default_transition": null,
      "position": {
        "x": 498.0464451619148,
        "y": -590.6037491300582
      },
      "assertions": [],
      "extraction_schema": [],
      "response_mapping": [],
      "suppress_tool_results": false,
      "tools": [
