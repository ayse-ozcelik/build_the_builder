              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "default": "https://freya-bank-mock.freyavoice.workers.dev/v1/verify_identity"
                },
                "body": {
                  "type": "object",
                  "required": [
                    "field",
                    "answer"
                  ],
                  "properties": {
                    "field": {
                      "enum": [
                        "date_of_birth",
                        "phone_last4"
                      ],
                      "type": "string",
                      "default": "{{field}}",
                      "description": "Which answer this is."
                    },
                    "answer": {
                      "type": "string",
                      "default": "{{answer}}",
                      "description": "date_of_birth as YYYY-MM-DD, phone_last4 as four digits."
                    },
                    "customer_id": {
                      "type": "string",
                      "default": "{{customer_id}}"
                    }
                  }
                },
                "method": {
                  "type": "string",
                  "default": "POST"
                },
                "headers": {
                  "type": "object",
                  "properties": {
                    "Content-Type": {
                      "type": "string",
                      "default": "application/json"
                    }
                  }
                }
              }
            }
          },
          "config": {
            "timeoutMs": 12000,
            "maxRetries": 0
          }
        },
        {
          "type": "function",
          "function": {
            "name": "end_call",
            "handler": "__function__:end_call",
            "description": "Ends the call. You normally do NOT call this: the phrase \"Have a good day.\" ends the call by itself. Call it without any text only if the customer answers after your goodbye.",
            "parameters": {
              "type": "object",
              "properties": {
                "message_mode": {
                  "type": "string",
                  "default": "none"
                },
                "interruptible": {
                  "type": "boolean",
                  "default": true
                },
                "trigger_pattern": {
                  "type": "string",
                  "default": "Have a good day|have a good day"
                },
                "trigger_timeout": {
                  "type": "number",
                  "default": 3
                },
                "trigger_pattern_both": {
                  "type": "string",
                  "default": "goodbye|bye|have a good day|you too|thank you|thanks|take care"
                }
              }
            }
          },
          "config": {
            "timeoutMs": 10000
          }
        }
      ],
      "pre_actions": [],
